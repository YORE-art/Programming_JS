let playerScore = 0;
for (let i = 0; i < 10; i++) {
    playerScore += 1;
}

function updateScore() {
    playerScore += 1;
}

function displayScore() {
    console.log('Player Score:', playerScore);
}

if (playerScore > 5) {
    displayScore();
} else {
    updateScore();
}

function checkScoreParity() {
    if (playerScore % 2 === 0) {
        console.log('Player score is even');
    } else {
        console.log('Player score is odd');
    }
}

checkScoreParity();
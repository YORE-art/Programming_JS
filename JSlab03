function convertCurrency(amount, fromCurrency, toCurrency) {
    let rate = 0;
    if (fromCurrency === 'USD' && toCurrency === 'EUR') {
        rate = 0.85;
    } else if (fromCurrency === 'EUR' && toCurrency === 'USD') {
        rate = 1.18;
    } else if (fromCurrency === 'USD' && toCurrency === 'CYP') {
        rate = 0.65;
    } else if (fromCurrency === 'CYP' && toCurrency === 'USD') {
        rate = 1.54;
    } else {
        console.log('Conversion rate not available for the given currencies.');
        return null;
    }
    let result = amount * rate;
    console.log(`${amount} ${fromCurrency} is equal to ${result.toFixed(2)} ${toCurrency}`);
    return result;
}
convertCurrency(100, 'USD', 'EUR');
convertCurrency(100, 'EUR', 'USD');
convertCurrency(100, 'USD', 'CYP');
convertCurrency(100, 'CYP', 'USD');